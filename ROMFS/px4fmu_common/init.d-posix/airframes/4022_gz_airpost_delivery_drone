#!/bin/sh
#
# @name Gazebo AirPost delivery drone
#
# @type Quadrotor
#

PX4_SIM_MODEL=${PX4_SIM_MODEL:=airpost_delivery_drone}

. ${R}etc/init.d-posix/airframes/4001_gz_x500

# Autonomous-offboard delivery config: this drone is flown by a companion computer (the airpost_drone
# ROS 2 node) over the uXRCE-DDS link, with no RC and no required MAVLink ground station. These are
# set at boot (param set-default) so the failsafe state machine never latches a datalink/RC-loss
# state that would block arming when only the DDS control link is present. They also hold on real
# hardware where the same node commands a Pixhawk over DDS.
param set-default COM_RC_IN_MODE 4     # RC input not required (no stick arming/override)
param set-default COM_RCL_EXCEPT 4     # exempt OFFBOARD from RC-loss failsafe
param set-default NAV_RCL_ACT 0        # no RC-loss failsafe action
param set-default NAV_DLL_ACT 0        # no datalink(GCS)-loss failsafe action — DDS is the control link
